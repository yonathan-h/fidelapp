# copy to .env.local (or set in your host's dashboard) -- Vite only exposes vars
# prefixed VITE_ to client code, and this one is safe to expose since it's just a URL

# the deployed backend's URL. omit for local dev -- api.js falls back to
# http://localhost:8000 automatically
VITE_API_BASE_URL=https://your-backend-host.example.com
