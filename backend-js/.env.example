# copy to .env and fill in real values -- .env is gitignored, this file isn't

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fidel_app

# long random string used to sign JWTs -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# never reuse a dev value in production, and never commit the real value
SECRET_KEY=

# comma-separated list of origins allowed to call this API (credentialed CORS
# requires an explicit allowlist, not a wildcard). include the deployed frontend's
# URL here in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# optional, defaults to 8000 -- most hosts (Render, Railway, etc.) set this for you
PORT=8000

# optional -- verification/reset emails are skipped (logged, not sent) if unset, auth
# itself still works. get a key at https://resend.com
RESEND_API_KEY=

# must be a verified sender on your Resend account. the default resend.dev test sender
# only delivers to the email address on your own Resend account -- verify a real domain
# to send to arbitrary signups
EMAIL_FROM=onboarding@resend.dev

# used to build the links inside verification/reset emails, e.g.
# https://your-app.vercel.app/verify-email?token=... -- set to the deployed frontend's
# URL in production
FRONTEND_URL=http://localhost:5173
